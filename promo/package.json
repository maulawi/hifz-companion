{
  "name": "qurra-hifz-lab-promo",
  "version": "1.0.0",
  "private": true,
  "description": "QURRA / Hifz Lab promotional video — Remotion project",
  "scripts": {
    "studio": "remotion studio",
    "still": "remotion still",
    "render:preview": "remotion render Batch01-EbookShowcase out/batch01-preview.mp4 --codec=h264 --crf=21",
    "render:final": "remotion render Batch01-EbookShowcase out/batch01-final.mp4 --codec=h264 --crf=15 --image-format=png --pixel-format=yuv420p --color-space=bt709 --x264-preset=slow",
    "typecheck": "tsc --noEmit",
    "render:full-promo": "remotion render HifzLab-FullPromo out/hifz-lab-full-promo.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
